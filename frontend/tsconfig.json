{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }, "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "src/**/*.d.ts"]
}
